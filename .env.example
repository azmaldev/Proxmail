# Server
PORT=8080
HOST=0.0.0.0

# Security — optional shared-secret auth on all API routes
AUTH_TOKEN=

# Verification engine tuning
SMTP_TIMEOUT_MS=10000
DNS_TIMEOUT_MS=5000
RATE_LIMIT_DELAY_MS=2000
RETRY_ATTEMPTS=2
RETRY_DELAY_MS=5000
MAX_CONCURRENT_DOMAINS=5
MAX_CONCURRENT_PER_DOMAIN=2
CATCHALL_TEST=true
CHECK_DISPOSABLE=true

# SMTP probing
SENDER_EMAIL=verifier@example.com
HELO_HOSTNAME=
