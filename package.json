{
  "name": "proxmail",
  "version": "1.0.0",
  "description": "Self-hosted email verification engine (Hono + TypeScript). SMTP probing, DNS analysis, catch-all detection — no third-party APIs, no per-email fees.",
  "type": "module",
  "license": "AGPL-3.0",
  "bin": {
    "proxmail": "./cli.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "cli": "tsx cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "dotenv": "^16.4.5",
    "hono": "^4.6.0",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/validator": "^13.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
